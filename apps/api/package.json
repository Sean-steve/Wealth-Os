{
  "name": "@wealth-os/api",
  "version": "0.4.1-b31",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts src",
    "test:integration": "vitest run --config vitest.config.ts test",
    "test:all": "vitest run --config vitest.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:ci:role": "tsx scripts/ci-role.ts",
    "check": "npm run typecheck && npm run test && npm run test:integration",
    "build": "tsc -p tsconfig.build.json",
    "staging:preflight": "tsx scripts/stagingPreflight.ts",
    "provider:certify": "tsx test/keycloak.provider.ts",
    "staging:activation:prove": "tsx scripts/liveActivation.ts",
    "local:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "local:api": "node --env-file=.env --import tsx src/server.ts",
    "local:test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.config.ts src",
    "local:certify": "node --env-file=.env --import tsx scripts/localCertification.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}

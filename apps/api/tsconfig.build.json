{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/migrate.ts",
    "scripts/stagingPreflight.ts",
    "scripts/liveActivation.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "test/**"
  ]
}

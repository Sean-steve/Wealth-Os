{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wealth-os.example/schema/event-envelope.v1.json",
  "title": "Wealth OS Domain Event Envelope v1 (proposal: transport not deployed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "subject",
    "actor",
    "correlation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^(wealth|finance|asset|company|family|legacy)\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "tenant_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "person_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": [
        "subject_id",
        "type"
      ],
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "PERSON",
            "SERVICE"
          ]
        }
      },
      "additionalProperties": false
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "source_as_of": {
      "type": "string",
      "format": "date-time"
    }
  }
}

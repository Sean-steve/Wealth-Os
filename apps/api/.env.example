# B3 API template (local development only, no actual credentials).
# Staging secrets must be stored separately at /etc/wealth-os/staging/api.env
# and must never reuse these placeholder URLs/passwords.
WEALTH_APP_DATABASE_URL=postgresql://wealth_app:local_dev_only_app_password@127.0.0.1:5546/wealth_os
WEALTH_MIGRATOR_DATABASE_URL=postgresql://postgres:local_dev_only_postgres_password@127.0.0.1:5546/wealth_os
WEALTH_INGEST_DATABASE_URL=postgresql://wealth_ingest:local_dev_only_ingest_password@127.0.0.1:5546/wealth_os
HOST=127.0.0.1
PORT=3009
RUNTIME_MODE=development
OIDC_ISSUER=https://issuer.example.test/
OIDC_AUDIENCE=wealth-os-api
OIDC_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
INTEGRATION_OIDC_ISSUER=https://issuer.example.test/
INTEGRATION_OIDC_AUDIENCE=wealth-os-source-ingest
INTEGRATION_OIDC_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
# STAGING/PRODUCTION: set only after the real issuer proves its MFA ACR mapping.
OIDC_REQUIRED_ACR=
OIDC_MAX_AUTH_AGE_SECONDS=900
OIDC_REQUIRE_VERIFIED_EMAIL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sean-steve.github.io
